# Interactive git branch selector using fzf
fbr() {
  local branches branch
  branches=$(git branch --all | grep -v HEAD) &&
  branch=$(echo "$branches" |
  fzf-tmux -d $(( 2 + $(wc -l <<< "$branches") )) +m) &&
  git checkout $(echo "$branch" | sed "s/.* //")
}

# List processes listening on TCP ports
listening() {
  if [ $# -eq 0 ]; then
    lsof -iTCP -sTCP:LISTEN -n -P
  elif [ $# -eq 1 ]; then
    lsof -iTCP -sTCP:LISTEN -n -P | grep -i --color $1
  else
    echo "Usage: listening [pattern]"
    echo "(you may want to use to sudo here!)"
  fi
}

# Update terminal tab/window titles with the current directory and running command.
terminal_title_sanitize() {
  emulate -L zsh
  setopt extended_glob

  local text="${1-}"
  text=${text//$'\e'/}
  text=${text//$'\a'/}
  text=${text//[[:cntrl:]]/ }
  text=${text//[[:space:]]##/ }
  text=${text# }
  text=${text% }

  print -r -- "$text"
}

terminal_title_pwd() {
  emulate -L zsh

  local cwd
  if (( $+functions[_fishy_collapsed_wd] )); then
    cwd=$(_fishy_collapsed_wd)
  else
    cwd=$(print -P -- '%~')
  fi

  terminal_title_sanitize "$cwd"
}

terminal_title_set() {
  emulate -L zsh

  [[ -o interactive && -t 1 && "$TERM" != "dumb" ]] || return

  local title
  title=$(terminal_title_sanitize "$1")
  [[ -n "$title" ]] || return

  printf '\e]0;%s\a\e]2;%s\a' "$title" "$title"
}

terminal_title_precmd() {
  emulate -L zsh
  terminal_title_set "$(terminal_title_pwd)"
}

terminal_title_preexec() {
  emulate -L zsh

  local cwd command title
  local separator=' | '
  local max_title_length=100
  local max_command_length

  cwd=$(terminal_title_pwd)
  command=$(terminal_title_sanitize "${2-}")

  if [[ -z "$cwd" || -z "$command" ]]; then
    terminal_title_set "$cwd"
    return
  fi

  max_command_length=$(( max_title_length - ${#cwd} - ${#separator} ))
  if (( max_command_length <= 0 )); then
    terminal_title_set "$cwd"
    return
  fi

  if (( ${#command} > max_command_length )); then
    if (( max_command_length > 3 )); then
      command="${command[1,$(( max_command_length - 3 ))]}..."
    else
      command="${command[1,$max_command_length]}"
    fi
  fi

  title="${cwd}${separator}${command}"
  terminal_title_set "$title"
}

add-zsh-hook precmd terminal_title_precmd
add-zsh-hook preexec terminal_title_preexec

