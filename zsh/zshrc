# ═══════════════════════════════════════════════════════════════
# 1. EARLY SETUP
# ═══════════════════════════════════════════════════════════════

# Fallback for terminals without terminfo on remote systems (e.g., Ghostty)
if [[ -n "$TERM" ]] && ! infocmp "$TERM" &>/dev/null; then
  export TERM=xterm-256color
fi

# OS detection
IS_MACOS=false
IS_WSL=false
if [[ "$OSTYPE" == "darwin"* ]]; then
  IS_MACOS=true
elif [[ -e /proc/version ]] && grep -q microsoft /proc/version; then
  IS_WSL=true
fi

# Start ssh-agent on Linux (macOS uses launchd to manage it)
if [[ "$IS_MACOS" == false ]] && [[ -z "$SSH_AUTH_SOCK" ]]; then
  eval "$(ssh-agent -s)" > /dev/null
fi

# ═══════════════════════════════════════════════════════════════
# 2. ZSH CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Initialize zsh completion system
autoload -Uz compinit && compinit

# Set up cache directory for oh-my-zsh plugins loaded via antidote
export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh"
mkdir -p "$ZSH_CACHE_DIR/completions"

# Initialize antidote
if command -v brew &>/dev/null; then
  source $(brew --prefix)/opt/antidote/share/antidote/antidote.zsh
elif [[ -f ~/.antidote/antidote.zsh ]]; then
  source ~/.antidote/antidote.zsh
fi
command -v antidote &>/dev/null && antidote load ~/.config/zsh_plugins

ZSH_CUSTOM=~/.config/zsh_custom

# Keybindings - map ctrl+left and ctrl+right to universal behaviors
bindkey -e
bindkey '^[[1;9C' forward-word
bindkey '^[[1;9D' backward-word

# ═══════════════════════════════════════════════════════════════
# 3. ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════

export LANG=en_US.UTF-8

# Editor
export EDITOR='nano'
export SVN_EDITOR="$EDITOR"
export GIT_EDITOR="$EDITOR"
export PYOPEN_CMD='code'

# Show user@hostname in prompt when connected via SSH
export DRACULA_DISPLAY_CONTEXT=1

# Screenshots (macOS)
export SCREENSHOTS_PATH=~/Documents/Screenshots

# Go
export GOPATH=~/src/go

# Python
export PYTHONDONTWRITEBYTECODE=1
export PYTHONSTARTUP="$HOME/.pythonrc.py"

# Poetry
export POETRY_HOME=~/.poetry
export POETRY_VIRTUALENVS_IN_PROJECT=1

# Volta (Node.js version manager)
export VOLTA_HOME=~/.volta

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"

# bun
export BUN_INSTALL="$HOME/.bun"

# NVM
export NVM_DIR="$HOME/.nvm"

# Fly.io
export FLYCTL_INSTALL="$HOME/.fly"

# ═══════════════════════════════════════════════════════════════
# 4. PATH CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Local binaries
export PATH="$HOME/.bin:$HOME/.local/bin:$PATH"

# Go
export PATH="$GOPATH/bin:$PATH"

# Rust/Cargo
export PATH="$HOME/.cargo/bin:$PATH"

# Poetry
export PATH="$POETRY_HOME/bin:$PATH"

# Volta
[[ ":$PATH:" != *":$VOLTA_HOME/bin:"* ]] && export PATH="$VOLTA_HOME/bin:$PATH"

# pnpm
[[ ":$PATH:" != *":$PNPM_HOME:"* ]] && export PATH="$PNPM_HOME:$PATH"

# bun
export PATH="$BUN_INSTALL/bin:$PATH"

# Fly.io
export PATH="$FLYCTL_INSTALL/bin:$PATH"

# Sentry devenv
[[ -d "$HOME/.local/share/sentry-devenv/bin" ]] && export PATH="$HOME/.local/share/sentry-devenv/bin:$PATH"

# Homebrew packages (macOS)
if [[ "$IS_MACOS" == true ]]; then
  export PATH="/usr/local/opt/gettext/bin:$PATH"
  export PATH="/usr/local/opt/ruby/bin:$PATH"
  export PATH="/usr/local/opt/llvm/bin:$PATH"
fi

# ═══════════════════════════════════════════════════════════════
# 5. TOOL INITIALIZATIONS
# ═══════════════════════════════════════════════════════════════

# fzf
[[ -f ~/.fzf.zsh ]] && source ~/.fzf.zsh

# direnv
command -v direnv &>/dev/null && eval "$(direnv hook zsh)"

# NVM (lazy load - only if installed)
[[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"
[[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"

# bun completions
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

# Google Cloud SDK
if [[ -d "$HOME/Downloads/google-cloud-sdk" ]]; then
  [[ -f "$HOME/Downloads/google-cloud-sdk/path.zsh.inc" ]] && source "$HOME/Downloads/google-cloud-sdk/path.zsh.inc"
  [[ -f "$HOME/Downloads/google-cloud-sdk/completion.zsh.inc" ]] && source "$HOME/Downloads/google-cloud-sdk/completion.zsh.inc"
fi

# ═══════════════════════════════════════════════════════════════
# 6. CUSTOM FUNCTIONS
# ═══════════════════════════════════════════════════════════════

# Interactive git branch selector using fzf
fbr() {
  local branches branch
  branches=$(git branch --all | grep -v HEAD) &&
  branch=$(echo "$branches" |
  fzf-tmux -d $(( 2 + $(wc -l <<< "$branches") )) +m) &&
  git checkout $(echo "$branch" | sed "s/.* //")
}

# List processes listening on TCP ports
listening() {
  if [ $# -eq 0 ]; then
    lsof -iTCP -sTCP:LISTEN -n -P
  elif [ $# -eq 1 ]; then
    lsof -iTCP -sTCP:LISTEN -n -P | grep -i --color $1
  else
    echo "Usage: listening [pattern]"
    echo "(you may want to use to sudo here!)"
  fi
}

# ═══════════════════════════════════════════════════════════════
# 7. OS-SPECIFIC SETTINGS
# ═══════════════════════════════════════════════════════════════

if [[ "$IS_MACOS" == true ]]; then
  mkdir -p "$SCREENSHOTS_PATH"
  defaults write com.apple.screencapture location "$SCREENSHOTS_PATH"
fi
