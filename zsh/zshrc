# ═══════════════════════════════════════════════════════════════
# 1. EARLY SETUP
# ═══════════════════════════════════════════════════════════════

# Fallback for terminals without terminfo on remote systems (e.g., Ghostty)
if [[ -n "$TERM" ]] && ! infocmp "$TERM" &>/dev/null; then
  export TERM=xterm-256color
fi

# OS detection
IS_MACOS=false
IS_WSL=false
if [[ "$OSTYPE" == "darwin"* ]]; then
  IS_MACOS=true
elif [[ -e /proc/version ]] && grep -q microsoft /proc/version; then
  IS_WSL=true
fi

# Start ssh-agent on Linux (macOS uses launchd to manage it)
if [[ "$IS_MACOS" == false ]] && [[ -z "$SSH_AUTH_SOCK" ]]; then
  eval "$(ssh-agent -s)" > /dev/null
fi

# ═══════════════════════════════════════════════════════════════
# 2. ZSH CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Initialize zsh completion hooks and helpers.
autoload -Uz add-zsh-hook bashcompinit compinit

# Resolve the real dotfiles zsh directory even when ~/.zshrc is symlinked here.
DOTFILES_ZSH_DIR="${${(%):-%N}:A:h}"

# Cache completion metadata for plugin-provided compdefs.
export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh"
mkdir -p "$ZSH_CACHE_DIR/completions"
export ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
[[ -f "$DOTFILES_ZSH_DIR/zinit_plugins.zsh" ]] && source "$DOTFILES_ZSH_DIR/zinit_plugins.zsh"

enable_bash_completion() {
  (( ${+functions[complete]} )) && return
  bashcompinit
}

restore_history_search_bindings() {
  (( ${+functions[history-substring-search-up]} )) || return

  if [[ -n "${terminfo[kcuu1]-}" ]]; then
    bindkey -M emacs "$terminfo[kcuu1]" history-substring-search-up
    bindkey -M viins "$terminfo[kcuu1]" history-substring-search-up
  fi

  if [[ -n "${terminfo[kcud1]-}" ]]; then
    bindkey -M emacs "$terminfo[kcud1]" history-substring-search-down
    bindkey -M viins "$terminfo[kcud1]" history-substring-search-down
  fi
}

# Keep the prompt working even when plugin bootstrap is incomplete.
load_local_dracula_theme() {
  local theme_path="$HOME/.config/zsh_custom/themes/zsh-theme/dracula.zsh-theme"

  (( $+functions[dracula_git_async] )) && return
  [[ -f "$theme_path" ]] && source "$theme_path"
}

if [[ -f "$ZINIT_HOME/zinit.zsh" ]]; then
  source "$ZINIT_HOME/zinit.zsh"
  (( ${+functions[dotfiles_load_zinit_plugins]} )) && dotfiles_load_zinit_plugins
fi
load_local_dracula_theme

# Initialize zsh completion system after all completion paths are available.
compinit -d "$ZSH_CACHE_DIR/.zcompdump"
(( ${+functions[_zinit]} )) && _comps[zinit]=_zinit
(( ${+functions[zinit]} )) && zinit cdreplay -q

ZSH_CUSTOM=~/.config/zsh_custom

# Keybindings - map ctrl+left and ctrl+right to universal behaviors
bindkey -e
restore_history_search_bindings
bindkey '^[[1;9C' forward-word
bindkey '^[[1;9D' backward-word

